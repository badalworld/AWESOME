#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y git python3-venv python3-pip

id trader >/dev/null 2>&1 || useradd --create-home --shell /usr/sbin/nologin trader

if [ ! -d /home/trader/awesome/.git ]; then
  sudo -u trader git clone ${repo_url} /home/trader/awesome
fi
cd /home/trader/awesome
sudo -u trader git fetch --all --tags
sudo -u trader git checkout ${repo_ref}

sudo -u trader python3 -m venv .venv
sudo -u trader .venv/bin/pip install -r requirements.txt
sudo -u trader mkdir -p data

cat > /etc/systemd/system/crypto-hunter.service <<'UNIT'
[Unit]
Description=Crypto Hunter Trading System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/awesome
ExecStart=/home/trader/awesome/.venv/bin/python run.py --port ${port}
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/trader/awesome/data

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now crypto-hunter
