{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No install step: the engine is self-hosted'",
  "buildCommand": "echo 'No build step: publishing static dashboard'",
  "outputDirectory": "app/web/static",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/api/:__engine_path*", "destination": "/api/engine-proxy" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
